{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "remote-advisor-relay",
  "main": "src/index.mjs",
  "compatibility_date": "2026-11-19",
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  },
  "kv_namespaces": [
    {
      "binding": "RELAY_KV",
      "id": "REPLACE_WITH_KV_NAMESPACE_ID"
    }
  ]
}
